# ---------------------------------------------------------------------------
# Google Maps (browser / client-side only)
# ---------------------------------------------------------------------------
# Referrer-restricted BROWSER key with the Maps JavaScript API enabled.
# Optional: if unset, the key injected by the Google Maps Platform connector
# (VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY) is used instead.
# Never put a server key in a VITE_ variable — VITE_ values ship to the browser.
VITE_GOOGLE_MAPS_API_KEY=

# Optional cloud-configured map style ID. Leave blank unless you actually
# created one in Google Cloud Console — standard maps work without it.
VITE_GOOGLE_MAPS_MAP_ID=
